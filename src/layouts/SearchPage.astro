---
import Footer from '../components/Footer.astro';
import index from '../data/search-index.json';
import shells from '../data/search-shells.json';
import { searchPages, searchPath } from '../lib/search/query.mjs';
const { language = 'en' } = Astro.props;
const shell = shells[language];
const url = new URL(Astro.request.url);
const result = searchPages(index, url.searchParams.get('s'), language, url.searchParams.get('paged') || 1);
const ar = language === 'ar';
const path = ar ? '/ar/search/' : '/search/';
const canonical = 'https://sv.fxem.com' + path;
const title = ar ? 'نتائج البحث | FXEM' : 'Search Results | FXEM';
const header = shell.header.replaceAll('__SEARCH_EN__', searchPath('en', result.query)).replaceAll('__SEARCH_AR__', searchPath('ar', result.query));
const pageUrl = page => `${path}?s=${encodeURIComponent(result.query)}&paged=${page}`;
Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
if (!['GET','HEAD'].includes(Astro.request.method)) { Astro.response.status=405; Astro.response.headers.set('Allow','GET, HEAD'); }
---
<!doctype html>
<html {...shell.htmlAttributes}>
  <head>
    <Fragment set:html={shell.head} />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={ar ? 'ابحث في صفحات ومقالات موقع FXEM.' : 'Search the pages and articles on the FXEM website.'} />
    <link rel="canonical" href={canonical} />
  </head>
  <body {...shell.bodyAttributes}>
    <a class="skip-link screen-reader-text" href="#content">{ar ? 'تخطي إلى المحتوى' : 'Skip to content'}</a>
    <div class="hfeed site" id="page">
      <Fragment set:html={header} />
      <div id="content" class="site-content">
        <div class="ast-container">
          <div id="primary" class="content-area primary">
            <section class="ast-archive-description">
              <h1 class="page-title ast-archive-title">{ar ? 'نتائج البحث عن: ' : 'Search Results for: '}<span>{result.query}</span></h1>
            </section>
            <main id="main" class="site-main">
              <div class="ast-row">
                {result.results.map(page => <article class="page type-page status-publish hentry ast-col-sm-12 ast-article-post">
                  <div class="ast-post-format- ast-no-thumb blog-layout-1"><div class="post-content ast-col-md-12">
                    <header class="entry-header"><h2 class="entry-title"><a href={page.url} rel="bookmark">{page.title}</a></h2></header>
                  </div></div>
                </article>)}
                {!result.total && <section class="no-results not-found ast-col-sm-12"><div class="page-content"><p>{ar ? 'لم يتم العثور على نتائج. جرّب كلمات بحث أخرى.' : 'No results found. Try another search.'}</p>
                  <form role="search" method="get" class="search-form" action={path}><label><span class="screen-reader-text">{ar ? 'بحث' : 'Search'}</span><input type="search" class="search-field" placeholder={ar ? 'بحث …' : 'Search …'} name="s" value={result.query} /></label><button type="submit" class="search-submit">{ar ? 'بحث' : 'Search'}</button></form>
                </div></section>}
              </div>
              {result.pageCount > 1 && <nav class="navigation pagination" aria-label={ar ? 'صفحات النتائج' : 'Results pages'}><div class="nav-links">
                {Array.from({length:result.pageCount},(_,i)=>i+1).map(page => page === result.page ? <span class="page-numbers current" aria-current="page">{page}</span> : <a class="page-numbers" href={pageUrl(page)}>{page}</a>)}
              </div></nav>}
            </main>
          </div>
        </div>
      </div>
      <Footer content={shell.footer} />
    </div>
    <Fragment set:html={shell.scripts} />
  </body>
</html>
