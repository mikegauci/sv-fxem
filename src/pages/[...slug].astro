---
import Footer from '../components/Footer.astro';
import CurrentDeskFormScripts from '../components/CurrentDeskFormScripts.astro';
import ContactFormScripts from '../components/ContactFormScripts.astro';
export function getStaticPaths() {
  const pages = import.meta.glob('../data/pages/*.json', { eager: true, import: 'default' });
  return Object.values(pages).map((page: any) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<!doctype html>
<html {...page.htmlAttributes}>
  <head><Fragment set:html={page.head} /></head>
  <body {...page.bodyAttributes}>
    {page.standalone ? <Fragment set:html={page.content} /> : <>
      <Fragment set:html={page.skipLink} />
      <div class="hfeed site" id="page">
        <Fragment set:html={page.header} />
        <Fragment set:html={page.content} />
        <Footer content={page.footer} />
      </div>
    </>}
    <Fragment set:html={page.scripts} />
    {page.currentdesk && <CurrentDeskFormScripts />}
    {page.contact && <ContactFormScripts />}
  </body>
</html>
