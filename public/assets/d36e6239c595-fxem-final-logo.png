			<script type="7e223843f821870f80056d94-text/javascript">
				$(document).ready(function() {
					if($('.headerstyle2').length > 0){
						var heightHeaderSticky2 = $('.headerstyle2').outerHeight() + 13;
						$('.fullpage').attr('style', 'padding-top:'+heightHeaderSticky2+'px');
					}
					$(window).resize(function(event) {
						if($('.headerstyle2').length > 0){
							var heightHeaderSticky2 = $('.headerstyle2').outerHeight() + 13;
							$('.fullpage').attr('style', 'padding-top:'+heightHeaderSticky2+'px');
						}
					});
				   	var scroll2 = $(window).scrollTop();
					if (scroll2 >= 300) {       
						$('#return-to-top').addClass('show');
					} else {
						$('#return-to-top').removeClass('show');
					}
					$(window).scroll(function() {
						if ($(this).scrollTop() >= 300) { 
							$('#return-to-top').addClass('show');
						} else {
						  $('#return-to-top').removeClass('show');
						}
					});
					$('#return-to-top').click(function(e) {
						e.preventDefault();
						$('html, body').animate({scrollTop:0});
					});


					var animation_elements = $.find('.slide-animated');
					var web_window = $(window);
					//check to see if any animation containers are currently in view
					function check_if_in_view() {
					    //get current window information
					    var window_height = web_window.height();
					    var window_top_position = web_window.scrollTop();
					    var window_bottom_position = (window_top_position + window_height);
					    //iterate through elements to see if its in view
						
						var transitionDelay = '';
					    $.each(animation_elements, function(i,val) {
					      	//get the elements information
					      	var element = $(this);
					      	var element_height = $(element).outerHeight();
					      	var element_top_position = $(element).offset().top;
					      	var element_bottom_position = (element_top_position + element_height);
					     	if(i== 0){
					      		var transitionDelay = 0.2;
					      	}else if ( i == 1){
					      		var transitionDelay = i * 0.2 + 0.15;
					      	}else {
					      		var transitionDelay = i * 0.2 + 0.15 - 0.05;
					      	}
						    //check to see if this current container is visible (its viewable if it exists between the viewable space of the viewport)
						    if ((element_bottom_position >= window_top_position) && (element_top_position <= window_bottom_position)) {
						        element.addClass('is-transitioned');
								$(this).attr('style', 'transition-delay:'+transitionDelay+"s;");
						    } else {
						    	element.removeClass('is-transitioned');
						    }
					    });
					}
					//on or scroll, detect elements in view
					$(window).on('scroll resize', function() {
					    check_if_in_view()
					});
				});
			</script>

			
			
			
	<section id="section_notfound_page" class="pageNotFoundSec">
		<script type="7e223843f821870f80056d94-text/javascript">
			$(document).ready(function() {
				$('img.svg').each(function(){
					var img = $(this);
					var imgID = img.attr('id');
					var imgClass = img.attr('class');
					var imgURL = img.attr('src');
					// Wrap the $.get call in a function to ensure a unique svg variable for each image
					(function(img) {
						$.get(imgURL, function(data) {
							var svg = $(data).find('svg');

							if(typeof imgID !== 'undefined') {
								svg.attr('id', imgID);
							}

							if(typeof imgClass !== 'undefined') {
								svg.attr('class', imgClass + ' replaced-svg');
							}

							svg.removeAttr('xmlns:a');

							var patternid = 'pattern' + imgID;
							console.log(patternid);

							// Change the pattern id and fill URL here
							svg.find('pattern').attr('id', patternid);
							/*svg.find('pattern').attr('fill', patternid);*/
							svg.find('rect').attr('fill', 'url(#'+patternid+')');

							if(!svg.attr('viewBox') && svg.attr('height') && svg.attr('width')) {
								svg.attr('viewBox', '0 0 ' + svg.attr('height') + ' ' + svg.attr('width'));
							}

							img.replaceWith(svg);
						}, 'xml');
					})(img); // Pass the current img to the function
				});
			});
		</script>
